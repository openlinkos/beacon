# install.sh copies this file to .env and fills in the three values below; set them in the environment to
# run it unattended (STATUS_HOST=… METRICS_HOST=… ACME_EMAIL=… ./install.sh). Nothing here is a secret.

# The Beacon release to run: a tag of ghcr.io/openlinkos/beacon. Pre-releases carry -rc.N.
BEACON_VERSION=v0.3.0-rc.15

# Two host names, both pointing at this machine. People and agents use STATUS_HOST (the API, MCP, the pages,
# and the SSH channel on port 17002); machines push to METRICS_HOST (the gateway). Caddy gets their
# certificates from Let's Encrypt, so ports 80 and 443 must be reachable from the Internet.
STATUS_HOST=status.example.com
METRICS_HOST=metrics.example.com

# Where Let's Encrypt sends notices about the certificates. Required; example.com addresses are refused.
ACME_EMAIL=
